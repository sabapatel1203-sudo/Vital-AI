# Vitalis AI Backend Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vitalis_ai?schema=public"

# JWT Authentication
JWT_SECRET="CHANGE_ME_use_a_strong_random_secret_at_least_32_chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="CHANGE_ME_use_another_strong_random_secret"
JWT_REFRESH_EXPIRES_IN="30d"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# AI Provider (configurable)
AI_PROVIDER="openai"
AI_API_KEY=""
AI_MODEL="gpt-4o"

# CORS
FRONTEND_URL="http://localhost:5173"
